{
  "name": "gateway",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx tests/run-unit.ts",
    "test:integration": "tsx tests/run-integration.ts",
    "test:all": "tsx tests/run-unit.ts && tsx tests/run-integration.ts",
    "test:coverage": "c8 --check-coverage --lines 70 --statements 70 --functions 70 --branches 70 --exclude \"src/server.ts\" --exclude \"tests/**\" tsx tests/run-unit.ts"
  },
  "dependencies": {
    "@centaur/shared": "*",
    "axios": "^1.6.7",
    "dotenv": "^16.4.1",
    "restana": "^4.9.9",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sinon": "^22.0.0",
    "@types/tape": "^5.8.1",
    "c8": "^12.0.0",
    "sinon": "^22.1.0",
    "tape": "^5.10.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
