# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=centaur_medical

# Security
JWT_SECRET=change-me-centaur-jwt-secret-min-32-chars
JWT_EXPIRES_IN=8h
SERVICE_TOKEN=change-me-internal-service-token

# Service ports
GATEWAY_PORT=3000
AUTH_PORT=3001
PATIENT_PORT=3002
NOTIFICATION_PORT=3003

# Service URLs (used by Gateway / Auth)
AUTH_SERVICE_URL=http://127.0.0.1:3001
PATIENT_SERVICE_URL=http://127.0.0.1:3002
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3003

# Notification scheduler (in-app PENDING → SENT)
NOTIFICATION_WORKER_INTERVAL_MS=5000

# SSE heartbeat (notification-service)
NOTIFICATION_SSE_HEARTBEAT_MS=20000

# Business notifications (patient-service → notification-service /internal/notifications/events)
# Disabled automatically when NODE_ENV=test unless BUSINESS_NOTIFICATIONS=1
# BUSINESS_NOTIFICATIONS=1

# SMTP (NodeMailer) — use Ethereal / Mailtrap in dev
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Centaur Medical <noreply@centaur.local>"

# Frontend URL (password reset links)
FRONTEND_URL=http://localhost:8084

# CORS
CORS_ORIGIN=http://localhost:8084
