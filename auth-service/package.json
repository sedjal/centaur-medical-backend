{
  "name": "auth-service",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx tests/run-unit.ts",
    "test:integration": "tsx tests/run-integration.ts",
    "test:all": "tsx tests/run-unit.ts && tsx tests/run-integration.ts",
    "test:coverage": "c8 --check-coverage --lines 70 --statements 70 --include \"src/**/*.ts\" --exclude \"src/server.ts\" --exclude \"tests/**\" tsx tests/run-all-coverage.ts",
    "test:coverage:unit": "c8 --check-coverage --lines 70 --statements 70 --include \"src/**/*.ts\" --exclude \"src/server.ts\" --exclude \"tests/**\" tsx tests/run-unit.ts"
  },
  "dependencies": {
    "@centaur/shared": "*",
    "argon2": "^0.40.1",
    "axios": "^1.6.7",
    "dotenv": "^16.4.1",
    "restana": "^4.9.9",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sinon": "^17.0.4",
    "@types/tape": "^5.8.1",
    "c8": "^10.1.3",
    "sinon": "^21.0.0",
    "tape": "^5.9.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  }
}
